{
  "name": "Python Development",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      // Passes your actual UID/GID from your host shell to the Docker build
      "USER_UID": "${localEnv:UID}",
      "USER_GID": "${localEnv:GID}"
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true, // Ensure this is explicitly true
  "settings": {
    "python.linting.pylintEnabled": true,
    "python.formatting.autopep8Enabled": true
  },
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance",
  ],
  "runArgs": [
    "--network=host"
  ],
  "postCreateCommand": "pip install -r requirements.txt",
  "shutdownAction": "removeContainer"
}
